# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/welfare_leakage
MONGODB_URL=mongodb://localhost:27017/welfare_leakage
REDIS_URL=redis://localhost:6379

# Auth — NEVER commit real values
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12
Aadhaar_HASH_SALT=change-me-in-production

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Mock
MOCK_OTP_CODE=123456
